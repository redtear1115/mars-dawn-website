// Static-assets Worker for marsdawn.southern-light.dev.
// No account ID here: it comes from CLOUDFLARE_ACCOUNT_ID.
// The custom domain is attached in the Cloudflare dashboard, so no routes are declared.
{
  "name": "marsdawn",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false
}
