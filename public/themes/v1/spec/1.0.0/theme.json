  "style": {
    "headingWeight": 700,
    "radius": 6,
    "h1": {
      "decoration": {
        "type": "shortRule",
        "color": "accent"
      }
    },
    "h2": {
      "letterSpacing": -0.01
    },
    "blockquote": {
      "style": {
        "type": "panel"
      }
    },
    "hr": {
      "style": {
        "type": "line",
        "color": "accent",
        "thickness": 2
      }
    },
    "table": {
      "header": {
        "type": "accentRule",
        "color": "accent"
      }
    }
