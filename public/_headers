# Security headers for every response. Cloudflare merges all matching rules,
# so the theme paths below get these as well as their cache rules.
# The pages are static: one same-origin stylesheet, same-origin images,
# system fonts, no scripts, no forms, no frames.
/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY

# Theme index: short cache so delisted or revoked themes disappear quickly.
/themes/v1/index.json
  Cache-Control: public, max-age=300

# Theme files are versioned and never change once published.
/themes/v1/*/*/*
  Cache-Control: public, max-age=31536000, immutable
