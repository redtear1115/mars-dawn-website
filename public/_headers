# Security headers for every response. Cloudflare merges all matching rules,
# so the theme paths below get these as well as their cache rules.
# The pages are static: one same-origin stylesheet, same-origin images,
# system fonts, no scripts, no forms, no frames.
/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY

# Theme index: short cache so delisted or revoked themes disappear quickly.
/themes/v1/index.json
  Cache-Control: public, max-age=300

# Theme files are versioned and never change once published.
# Cloudflare allows one splat per rule, so the id and version are named placeholders.
/themes/v1/:id/:version/*
  Cache-Control: public, max-age=31536000, immutable

# Agent/LLM discovery: llms.txt, its full-content twin and our own robots.txt.
# Content type isn't inferred for these extensions, so it's set explicitly.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

# Sitemap.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=300

# Markdown twins of every page. Cloudflare's _headers allows only one splat
# per rule, so a suffix pattern like /*.md is not a reliable way to match
# nested paths; these eight paths are listed explicitly instead.
